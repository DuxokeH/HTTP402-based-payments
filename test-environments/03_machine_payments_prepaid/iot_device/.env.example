# ── Mock IoT device (metered session) — copy to .env ───────────────────────
NODE_ENV=development
IOT_PORT=3200
LOG_LEVEL=info

NETWORK=sepolia
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MIN_CONFIRMATIONS=1

# true = measure protocol without spending test ETH; false = real Sepolia + Wireshark
MOCK_VERIFY=false

# Metered pricing (default: per-reading value equals folder 02 => clean comparison)
PRICE_WEI_PER_CALL=100000000000
PRICE_WEI_PER_BYTE=0
MIN_PRICE_WEI=100000000000
ETH_EUR_RATE=2500

# Signed-debit nonce freshness window (ms)
DEBIT_MAX_AGE_MS=120000

# Session validity (seconds): default and hard maximum; minimum top-up (wei)
SESSION_TTL_DEFAULT=3600
SESSION_TTL_MAX=86400
MIN_TOPUP_WEI=1

# ── Skrbniška prijava (glej ../../README.md) ─────────────────────────────────
# Naprava je zaprta; javna ostaneta samo /health in /prijava. Poverilnice se ob
# prvem zagonu ustvarijo same v data/admin-credentials.txt (pravice 0600):
#   grep GESLO data/admin-credentials.txt      # za prijavo v brskalniku
#   grep ZETON data/admin-credentials.txt      # za merilnega agenta (Bearer)
# Spodnje nastavi SAMO, če hoceš poverilnice določiti sam (takrat se nič ne
# zapiše na disk):
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# ADMIN_TOKEN=
ADMIN_SESSION_TTL_SECONDS=28800
# Pusti na false: `Secure` se doda samodejno pod HTTPS. Vsiljen true onemogoci
# prijavo v brskalniku po navadnem HTTP (dostop za Wireshark).
COOKIE_SECURE=false

# ── x402 v2 (VZPOREDNI način — TESTNO: ETH na Ethereum Sepolii; poravnava samo mock) ──
# Obstoječe spremenljivke zgoraj veljajo za domači ETH tok in se NE spreminjajo.
# X402_MODE=off      → /x402/* poti se ne priklopijo (privzeto)
# X402_MODE=self     → strežnik sam preverja in poravnava prek X402_RPC_URL
# X402_MOCK=true     → prava preverjanja podpisov, sintetične poravnave (0x6d6f636b…)
# POZOR: pravi (ne-mock) tek zahteva žeton z EIP-3009 — domači ETH ga nima,
# zato je poravnava v tej testni konfiguraciji vedno sintetična/mock.
#X402_MODE=self
#X402_MOCK=true
#X402_MOCK_FAULTS=false
#X402_NETWORK=eip155:11155111
#X402_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#X402_MERCHANT_ADDRESS=
#X402_SETTLEMENT_PRIVATE_KEY=
#X402_PRICE_ATOMIC=100000000000
# ↑ 0.0000001 ETH — enako ceni/odčitku domačega toka
#X402_MIN_CONFIRMATIONS=1
#X402_SETTLE_TIMEOUT_MS=60000
#X402_SESSION_DEPOSIT_ATOMIC=2000000000000
# ↑ 0.000002 ETH — polog predplačniške seje
