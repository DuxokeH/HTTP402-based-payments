# ─────────────────────────────────────────────────────────────────────────────
#  Caddy (reverse proxy with TLS) for the 04_website_facilitator folder — FACILITATOR BRANCH
#  docs/IDENTITY.md §2, improvement A
#
#  What is special about this branch: the PAYER talks to TWO services —
#    /            → merchant  (402 challenge, access to the resource)
#    /facilitator/* → facilitator (POST /submit-payment; arrow C→F of the facilitator flow)
#
#  That is why the facilitator is exposed here under the `/facilitator` prefix.
#  Set server/.env accordingly:
#      FACILITATOR_PUBLIC_URL=https://your-domain.example/facilitator
#      FACILITATOR_URL=http://facilitator:4000
#  The merchant writes this address into the 402 response and the browser uses it directly.
#
#  Usage:
#    1) Replace `your-domain.example` below with a real domain pointing at this server.
#    2) Open ports 80 and 443 (Caddy obtains a Let's Encrypt certificate on its own).
#    3) `docker compose up -d` in this folder.
#
#  WARNING (Wireshark): under TLS the content is not visible. For screenshot proof
#  of the flow, uncomment `ports` in docker-compose.yml and capture HTTP on port 8081
#  (client↔merchant) AND 4000 (client↔facilitator). Only both together show
#  all 5 exchanges of the facilitator flow. See ../README.md.
#  HSTS below tells the browser not to access THIS domain over http:// for a year,
#  so do the capture via IP:8081 and IP:4000, not via the domain.
#
#  ⚠ WARNING (money): the /run/tx and /run/metered paths trigger the built-in M2M agent.
#  In REAL mode they spend a real wallet. The application locks them behind the
#  admin login (see ../README.md). For a public demo leave MOCK_VERIFY=true.
# ─────────────────────────────────────────────────────────────────────────────

your-domain.example {
    encode zstd gzip

    # ── Facilitator under the /facilitator prefix ────────────────────────────
    # `handle_path` strips the prefix, so the facilitator sees /submit-payment and
    # not /facilitator/submit-payment — its paths stay unchanged.
    handle_path /facilitator/* {
        reverse_proxy facilitator:4000
    }

    # ── Everything else goes to the merchant ─────────────────────────────────
    handle {
        # Shields the M2M agent runner from the public (see the warning above).
        # Create the password with:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
        #
        # @runner path /run/*
        # basic_auth @runner {
        #     demo <paste-hash-here>
        # }

        reverse_proxy merchant:8081 {
            # Server-Sent Events (/run/tx, /run/metered) must not be buffered.
            flush_interval -1
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Content-Type-Options "nosniff"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}

# Optional: local TLS testing (Caddy issues a self-signed certificate;
# the browser will warn — that is fine for development).
#
# localhost {
#     handle_path /facilitator/* {
#         reverse_proxy facilitator:4000
#     }
#     handle {
#         reverse_proxy merchant:8081 {
#             flush_interval -1
#         }
#     }
# }
