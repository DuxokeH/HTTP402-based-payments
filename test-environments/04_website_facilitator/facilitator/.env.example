# ── X402 FACILITATOR (facilitator) — copy to .env ──────────────────────────────
# This is the ONLY process in the 04_website_facilitator folder that talks to the chain.
# The merchant (../server) has no `JsonRpcProvider` at all — that is the essence of topology (b).
NODE_ENV=development
FACILITATOR_PORT=4000
LOG_LEVEL=info

NETWORK=sepolia
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Enforced, not merely documented (fix for bug 4 of the old implementation).
MIN_CONFIRMATIONS=1

# true = no chain (demo/mock measurements). Set the same value for the merchant,
# otherwise the merchant will send real transactions to a facilitator that does
# not verify them. `MOCK_FACILITATOR=true` works as an alias for the same thing.
MOCK_VERIFY=true

# How many concurrent chain reads the facilitator allows; the excess gets an
# immediate 429 and does NOT pile up in a queue. The limit is not tied to the IP
# (see ../../docs/IDENTITY.md).
MAX_CHAIN_READS_IN_FLIGHT=8

# Lifetimes (same as in the direct branch — the comparison must be fair)
PROOF_TOKEN_TTL_SECONDS=600
PAYMENT_REQUEST_TTL_SECONDS=1800

# Metered session: the facilitator keeps the credit, budget and validity
DEBIT_MAX_AGE_MS=120000
SESSION_TTL_DEFAULT=3600
SESSION_TTL_MAX=86400

# ── Admin login (see ../../README.md) ───────────────────────────────────────
# The facilitator authenticates MERCHANTS, not payers.
#   public:         /health, /config, /submit-payment
#   machine token:  /payment-request, /verify-proof, /session/*, /debit
# Read the token with:  grep TOKEN data/admin-credentials.txt
# and give it to the merchant as FACILITATOR_TOKEN in ../server/.env
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# ADMIN_TOKEN=
ADMIN_SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false

# ── x402 v2 (PARALLEL mode — official protocol; test: ETH, Ethereum Sepolia) ──
# The existing variables above apply to the native ETH flow and do NOT change.
# X402_MODE=off      → the /x402/* routes are not mounted (default)
# X402_MODE=self     → the server verifies and settles by itself via X402_RPC_URL
# X402_MOCK=true     → real signature checks, synthetic settlements (0x6d6f636b…)
#X402_MODE=self
#X402_MOCK=true
#X402_MOCK_FAULTS=false
# Settlement is always synthetic/mock in this configuration (native ETH has no
# EIP-3009 contract); a real (non-mock) run requires an EIP-3009 token (e.g. USDC/EURC).
#X402_NETWORK=eip155:11155111
#X402_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#X402_MERCHANT_ADDRESS=
#X402_SETTLEMENT_PRIVATE_KEY=
#X402_PRICE_ATOMIC=100000000000   # 0.0000001 ETH — same as the native flow
#X402_MIN_CONFIRMATIONS=1
#X402_SETTLE_TIMEOUT_MS=60000
