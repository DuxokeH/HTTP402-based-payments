# ── X402 website — FACILITATOR BRANCH (merchant) — copy to .env ──────────────
# This process has NO chain access. Everything that is a JSON-RPC call in the
# 05_website_direct folder is a facilitator call here (../facilitator). See ../README.md.
NODE_ENV=development
# 8081, so this branch can run alongside the direct one (folder 05 uses 8080).
PORT=8081
LOG_LEVEL=info

# ── Facilitator ────────────────────────────────────────────────────────────────
# Where the MERCHANT calls (normally loopback: both processes run on the same host).
FACILITATOR_URL=http://127.0.0.1:4000
# What the merchant writes into the 402 response so the PAYER knows where to send
# /submit-payment. If the payer is not on the same machine (browser, external
# agent), this must be an address reachable from outside — e.g. http://<server-IP>:4000
FACILITATOR_PUBLIC_URL=http://127.0.0.1:4000
# The facilitator's machine token. If you do not set it, the merchant reads it from
# the neighbouring folder (../facilitator/data/admin-credentials.txt) — works for a
# co-located deployment.
#   grep TOKEN ../facilitator/data/admin-credentials.txt
# FACILITATOR_TOKEN=
FACILITATOR_TIMEOUT_MS=20000
# Merchant label in the facilitator's ledger (the facilitator is a multi-merchant service).
MERCHANT_ID=default

NETWORK=sepolia
# ONLY a hint that the merchant forwards to the browser and the built-in agent — both
# are payers and are allowed on the chain (arrow C→B). The merchant itself does not
# use it and does not build a `JsonRpcProvider` from it. Test: set it to nonsense and
# run a measurement with the external agent — payments must still work.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# true = demo without a real chain. Set the SAME value for the facilitator
# (../facilitator/.env), otherwise the branch is inconsistent; /health reports this as `mockMismatch`.
MOCK_VERIFY=true

# Prices (testnet, reporting only). Per-reading value is equal in both M2M tabs → fair comparison.
SERVICE_PRICE_ETH=0.0000001
PRICE_WEI_PER_READING=100000000000
PRICE_WEI_PER_CALL=100000000000
PRICE_WEI_PER_BYTE=0
MIN_PRICE_WEI=100000000000
ETH_EUR_RATE=2500

# Metered session — prices are set by the MERCHANT; credit/budget/validity is managed by the FACILITATOR.
SESSION_TTL_DEFAULT=3600
# Real-mode top-up value (wei) sent by the M2M agent to open a session
TOPUP_WEI=2500000000000

# TTL of the payment request the merchant orders from the facilitator (the proof token has its TTL at the facilitator).
PAYMENT_REQUEST_TTL_SECONDS=1800

# ── Merchant admin login (see ../../README.md) ──────────────────────────────
# The facilitator has ITS OWN, separate login (../facilitator/data/admin-credentials.txt).
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# ADMIN_TOKEN=
ADMIN_SESSION_TTL_SECONDS=28800

# ── Session token `sid` (docs/IDENTITY.md §2, improvement B) ─────────────────
WEB_SESSION_TTL_SECONDS=1800
COOKIE_SECURE=false

# ── x402 v2 (PARALLEL mode — facilitated via the local facilitator) ──────────
# The merchant NEVER has X402_RPC_URL (it refuses it at startup) — verification and
# settlement (test: ETH, synthetic) are done entirely by the facilitator via /x402/verify
# and /x402/settle; it finds the facilitator via FACILITATOR_URL above.
#X402_MODE=facilitated
# The network in the merchant's paymentRequirements MUST match the facilitator's.
#X402_NETWORK=eip155:11155111
#X402_MERCHANT_ADDRESS=
#X402_PRICE_ATOMIC=100000000000   # 0.0000001 ETH — same as the native flow
