# ── X402 spletišče — POSREDNIŠKA VEJA (trgovec) — kopiraj v .env ─────────────
# Ta proces NIMA dostopa do verige. Vse, kar je v mapi 05_spletisce klic
# JSON-RPC, je tu klic posrednika (../posrednik). Glej ../README.md.
NODE_ENV=development
# 8081, da lahko ta veja teče hkrati z neposredno (mapa 05 uporablja 8080).
PORT=8081
LOG_LEVEL=info

# ── Posrednik ────────────────────────────────────────────────────────────────
# Kamor kliče TRGOVEC (praviloma loopback: oba procesa sta na istem gostitelju).
POSREDNIK_URL=http://127.0.0.1:4000
# Kar trgovec zapiše v odgovor 402, da PLAČNIK ve, kam poslati /submit-payment.
# Če plačnik ni na istem računalniku (brskalnik, zunanji agent), mora biti to
# naslov, ki je dosegljiv od zunaj — npr. http://<IP-strežnika>:4000
POSREDNIK_PUBLIC_URL=http://127.0.0.1:4000
# Strojni žeton posrednika. Če ga ne nastaviš, ga trgovec prebere iz sosednje
# mape (../posrednik/data/admin-credentials.txt) — deluje pri sokrajevni namestitvi.
#   grep ZETON ../posrednik/data/admin-credentials.txt
# POSREDNIK_TOKEN=
POSREDNIK_TIMEOUT_MS=20000
# Oznaka trgovca v knjigi posrednika (posrednik je storitev za več trgovcev).
MERCHANT_ID=default

NETWORK=sepolia
# SAMO namig, ki ga trgovec posreduje brskalniku in vgrajenemu agentu — oba sta
# plačnika in smeta na verigo (puščica C→B). Trgovec sam ga ne uporabi
# in iz njega ne naredi `JsonRpcProvider`. Preizkus: nastavi ga na nesmisel in
# poženi meritev z zunanjim agentom — plačila morajo še vedno delovati.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# true = demo brez prave verige. ISTO vrednost nastavi tudi posredniku
# (../posrednik/.env), sicer veja ni skladna; /health to javi kot `neskladjeMock`.
MOCK_VERIFY=true

# Prices (testnet, reporting only). Per-reading value is equal in both M2M tabs → fair comparison.
SERVICE_PRICE_ETH=0.0000001
PRICE_WEI_PER_READING=100000000000
PRICE_WEI_PER_CALL=100000000000
PRICE_WEI_PER_BYTE=0
MIN_PRICE_WEI=100000000000
ETH_EUR_RATE=2500

# Merjena seja — cene določa TRGOVEC, dobroimetje/proračun/veljavnost pa vodi POSREDNIK.
SESSION_TTL_DEFAULT=3600
# Real-mode top-up value (wei) sent by the M2M agent to open a session
TOPUP_WEI=2500000000000

# TTL plačilne zahteve, ki jo trgovec naroči posredniku (dokazni žeton ima TTL pri posredniku).
PAYMENT_REQUEST_TTL_SECONDS=1800

# ── Skrbniška prijava trgovca (glej ../../README.md) ────────────────────────
# Posrednik ima SVOJO, ločeno prijavo (../posrednik/data/admin-credentials.txt).
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# ADMIN_TOKEN=
ADMIN_SESSION_TTL_SECONDS=28800

# ── Sejni žeton `sid` (docs/IDENTITETA.md §2, izboljšava B) ─────────────────────
WEB_SESSION_TTL_SECONDS=1800
COOKIE_SECURE=false

# ── x402 v2 (VZPOREDNI način — facilitirano prek lokalnega posrednika) ───────
# Trgovec NIKOLI nima X402_RPC_URL (ob zagonu ga odkloni) — preverjanje in
# poravnavo (testno: ETH, sintetična) v celoti opravi posrednik prek /x402/verify
# in /x402/settle; posrednika najde prek POSREDNIK_URL zgoraj.
#X402_MODE=facilitated
# Omrežje v trgovčevih paymentRequirements se MORA ujemati s posrednikovim.
#X402_NETWORK=eip155:11155111
#X402_MERCHANT_ADDRESS=
#X402_PRICE_ATOMIC=100000000000   # 0.0000001 ETH — kot domači tok
