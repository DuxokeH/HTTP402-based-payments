# ── X402 showcase site — copy to .env ──────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

NETWORK=sepolia
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MIN_CONFIRMATIONS=1

# true = demo without real chain (M2M tabs work with no funds; MetaMask tab shows a Demo button)
# false = real Sepolia (MetaMask tab pays for real; M2M tabs need a funded payer key in wallet.json)
MOCK_VERIFY=true

# Prices (testnet, reporting only). Per-reading value is equal in both M2M tabs → fair comparison.
SERVICE_PRICE_ETH=0.0000001
PRICE_WEI_PER_READING=100000000000
PRICE_WEI_PER_CALL=100000000000
PRICE_WEI_PER_BYTE=0
MIN_PRICE_WEI=100000000000
ETH_EUR_RATE=2500

# Metered session
DEBIT_MAX_AGE_MS=120000
SESSION_TTL_DEFAULT=3600
SESSION_TTL_MAX=86400
# Real-mode top-up value (wei) sent by the M2M agent to open a session
TOPUP_WEI=2500000000000

# TTLs
PROOF_TOKEN_TTL_SECONDS=600
PAYMENT_REQUEST_TTL_SECONDS=1800

# ── Admin login (see ../../README.md) ────────────────────────────────────────
# The entire website is locked down; only /health and /login remain public.
# Credentials are generated automatically on first start in data/admin-credentials.txt (0600):
#   grep GESLO data/admin-credentials.txt      # for logging in via the browser
#   grep TOKEN data/admin-credentials.txt      # machine token (Bearer)
# Set the values below ONLY if you want to choose the credentials yourself (nothing is written to disk then):
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# ADMIN_TOKEN=
ADMIN_SESSION_TTL_SECONDS=28800

# ── Session token `sid` (docs/IDENTITY.md §2, improvement B) ───────────────────
# Cookie for CORRELATING events of the same session (402 -> proof -> access).
# It is NEVER a precondition for access: a missing/altered sid or a change of IP
# does not reject the request, so the flow survives a network switch
# (wifi <-> mobile internet, NAT).
WEB_SESSION_TTL_SECONDS=1800
# Leave at false. The `Secure` flag is added AUTOMATICALLY when the request comes
# in over HTTPS (also from behind Caddy via X-Forwarded-Proto). If you force this
# to true, browser login over plain HTTP (access for Wireshark) will not work —
# the browser will not save such a cookie.
COOKIE_SECURE=false

# ── x402 v2 (PARALLEL mode — official protocol; TEST: ETH, Ethereum Sepolia) ─
# The existing variables above apply to the native ETH flow and do NOT change.
# X402_MODE=off      → the /x402/* routes are not mounted (default)
# X402_MODE=self     → the server verifies and settles by itself via X402_RPC_URL
# X402_MOCK=true     → real signature checks, synthetic settlements (0x6d6f636b…)
# CAUTION: the server refuses a real (non-mock) start with the test (placeholder)
# asset — settlement is always synthetic/mock in this configuration.
#X402_MODE=self
#X402_MOCK=true
#X402_MOCK_FAULTS=false
#X402_NETWORK=eip155:11155111
#X402_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#X402_MERCHANT_ADDRESS=
#X402_SETTLEMENT_PRIVATE_KEY=
#X402_PRICE_ATOMIC=100000000000
# ↑ 0.0000001 ETH in wei — same price as in the native ETH flow
#X402_MIN_CONFIRMATIONS=1
#X402_SETTLE_TIMEOUT_MS=60000
#X402_SESSION_DEPOSIT_ATOMIC=2000000000000
# ↑ 0.000002 ETH in wei — metered-session deposit
