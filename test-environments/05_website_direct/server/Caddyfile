# ─────────────────────────────────────────────────────────────────────────────
#  Caddy (reverse proxy with TLS) for the 05_website_direct folder
#  docs/IDENTITY.md §2, improvement A
#
#  Why: `proofToken` is a "bearer" token — whoever holds it gets access. Over plain
#  HTTP on a public network it can be intercepted. The real fix is TLS, NOT tying
#  access to an IP address (reasons in docs/IDENTITY.md §0).
#
#  Usage:
#    1) Replace `your-domain.example` below with a real domain pointing at this server.
#    2) Open ports 80 and 443 (Caddy obtains a Let's Encrypt certificate on its own).
#    3) `docker compose up -d` in this folder.
#
#  WARNING (Wireshark): for screenshot proof of the flow (402, X-Payment, X-Signature)
#  use HTTP access over LAN/loopback on port 8080 — under TLS the content is
#  encrypted and not visible in the capture. See ../../README.md.
#  HSTS below tells the browser not to access THIS domain over http:// for a year,
#  so do the capture via IP:8080, not via the domain.
#
#  ⚠ WARNING (money): the /run/tx and /run/metered paths trigger the built-in M2M agent.
#  In REAL mode (MOCK_VERIFY=false, payerPrivateKey in wallet.json) they spend a real
#  wallet. The application locks them behind the admin login (see ../../README.md), so
#  extra protection in Caddy is not needed — the `basic_auth` below is only if you
#  want a double lock. For a public demo the safest choice is to leave MOCK_VERIFY=true.
# ─────────────────────────────────────────────────────────────────────────────

your-domain.example {
    encode zstd gzip

    # Shields the M2M agent runner from the public (see the warning above).
    # Create the password with:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
    #
    # @runner path /run/*
    # basic_auth @runner {
    #     demo <paste-hash-here>
    # }

    # Forward everything to the Node app on the docker network (listens on 8080 by default).
    reverse_proxy x402-website-direct:8080 {
        # Server-Sent Events (/run/tx, /run/metered) must not be buffered.
        flush_interval -1
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Content-Type-Options "nosniff"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}

# Optional: local TLS testing (Caddy issues a self-signed certificate;
# the browser will warn — that is fine for development).
#
# localhost {
#     reverse_proxy x402-website-direct:8080 {
#         flush_interval -1
#     }
# }
