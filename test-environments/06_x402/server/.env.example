# ── X402 merged one-time merchant (4 messages) — copy to .env ───────────────
NODE_ENV=development
MERCHANT_PORT=3300
LOG_LEVEL=info

# Blockchain
NETWORK=sepolia
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MIN_CONFIRMATIONS=1

# Set true to measure PROTOCOL latency without spending test ETH (mock control).
# Leave false/unset for real Sepolia demos and Wireshark captures.
MOCK_VERIFY=false

# Price for one /service access. Default 1e-7 ETH ≈ 0.025 euro-cent at ETH_EUR_RATE (testnet, reporting only).
SERVICE_PRICE_ETH=0.0000001
ETH_EUR_RATE=2500

# Proof/request lifetimes (seconds). Lower PAYMENT_REQUEST_TTL to test expiry.
PROOF_TOKEN_TTL_SECONDS=600
PAYMENT_REQUEST_TTL_SECONDS=1800

# CORS (leave empty in dev)
ALLOWED_ORIGINS=

# External API (optional). Empty = deterministic demo payload (best for clean latency).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=400
OPENAI_DAILY_USD_CAP=5

# ── x402 v2 (PARALLEL mode — official protocol; TEST: ETH on Ethereum Sepolia — settlement mock only) ─
# The existing variables above apply to the merged ETH flow and do NOT change.
# X402_MODE=off      → the /x402/* routes are not mounted (default)
# X402_MODE=self     → the server verifies and settles on its own via X402_RPC_URL
# X402_MOCK=true     → real signature verification, synthetic settlements (0x6d6f636b…)
# A real (non-mock) run requires an EIP-3009 token: set X402_USDC_ADDRESS + X402_ASSET_*.
#X402_MODE=self
#X402_MOCK=true
#X402_MOCK_FAULTS=false
#X402_NETWORK=eip155:11155111
#X402_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#X402_MERCHANT_ADDRESS=
#X402_SETTLEMENT_PRIVATE_KEY=
#X402_PRICE_ATOMIC=10000
#X402_MIN_CONFIRMATIONS=1
#X402_SETTLE_TIMEOUT_MS=60000
