# ── Mock IoT device (per-tx) — copy to .env ────────────────────────────────
NODE_ENV=development
IOT_PORT=3100
LOG_LEVEL=info

NETWORK=sepolia
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MIN_CONFIRMATIONS=1

# true = measure protocol without spending test ETH; false = real Sepolia + Wireshark
MOCK_VERIFY=false

# Price per reading. Default 1e-7 ETH ≈ 0.025 euro-cent at ETH_EUR_RATE (testnet, reporting only).
#   1e-6 cent = 1e-8 EUR ; at 2500 EUR/ETH -> 4e-12 ETH = 4000000 wei
PRICE_WEI_PER_READING=100000000000
ETH_EUR_RATE=2500

PROOF_TOKEN_TTL_SECONDS=600
PAYMENT_REQUEST_TTL_SECONDS=1800

# ── Admin login (see ../../README.md) ────────────────────────────────────────
# The device is locked down; only /health and /login remain public. Credentials
# are created automatically on first start in data/admin-credentials.txt (permissions 0600):
#   grep PASSWORD data/admin-credentials.txt   # for browser login
#   grep TOKEN data/admin-credentials.txt      # for the measurement agent (Bearer)
# Set the values below ONLY if you want to define the credentials yourself
# (nothing is written to disk in that case):
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# ADMIN_TOKEN=
ADMIN_SESSION_TTL_SECONDS=28800
# Leave at false: `Secure` is added automatically under HTTPS. Forcing true
# disables browser login over plain HTTP (Wireshark access).
COOKIE_SECURE=false

# ── x402 v2 (PARALLEL mode — official protocol; Ethereum Sepolia + ETH — test) ──
# The existing variables above apply to the native ETH flow and do NOT change.
# X402_MODE=off      → the /x402/* routes are not mounted (default)
# X402_MODE=self     → the server verifies and settles on its own via X402_RPC_URL
# X402_MOCK=true     → real signature verification, synthetic settlements (0x6d6f636b…)
# A real (non-mock) run requires an EIP-3009 token — the test ETH configuration runs mock only.
#X402_MODE=self
#X402_MOCK=true
#X402_MOCK_FAULTS=false
#X402_NETWORK=eip155:11155111
#X402_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#X402_MERCHANT_ADDRESS=
#X402_SETTLEMENT_PRIVATE_KEY=
#X402_PRICE_ATOMIC=10000
#X402_MIN_CONFIRMATIONS=1
#X402_SETTLE_TIMEOUT_MS=60000
