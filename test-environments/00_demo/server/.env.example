# ─────────────────────────────────────────────────────────
# X402 SERVER — environment configuration
# Copy to `.env` (development) or `.env.production` (deployment).
# Never commit the resulting file — see .gitignore.
# ─────────────────────────────────────────────────────────

# Runtime ───────────────────────────────────────────────────
NODE_ENV=development
MERCHANT_PORT=3000
LOG_LEVEL=info

# Blockchain ────────────────────────────────────────────────
NETWORK=sepolia
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Alternatives:
# RPC_URL=https://rpc.sepolia.org
# RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
MIN_CONFIRMATIONS=1

# Service pricing ───────────────────────────────────────────
SERVICE_PRICE_ETH=0.0001

# Payment token TTLs (seconds) ──────────────────────────────
PROOF_TOKEN_TTL_SECONDS=600
PAYMENT_REQUEST_TTL_SECONDS=1800

# CORS — comma-separated list of allowed origins ────────────
# Leave empty in development. In production set to your domain, e.g.:
# ALLOWED_ORIGINS=https://x402.example.com,https://www.x402.example.com
ALLOWED_ORIGINS=

# OpenAI ────────────────────────────────────────────────────
# Leave OPENAI_API_KEY empty to run in demo mode (paid requests get a stub response).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_MAX_PROMPT_CHARS=4000
# Soft daily ceiling, in USD. Server refuses further AI calls once exceeded.
# This is your second line of defense — set a HARD monthly cap in the
# OpenAI billing dashboard as the primary safeguard.
OPENAI_DAILY_USD_CAP=5

# Database ──────────────────────────────────────────────────
# Defaults to ./data/x402.db. Override only if mounting a volume elsewhere.
# DB_PATH=/app/data/x402.db
