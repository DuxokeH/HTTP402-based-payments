# ── X402 showcase site — copy to .env ──────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

NETWORK=sepolia
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MIN_CONFIRMATIONS=1

# true = demo without real chain (M2M tabs work with no funds; MetaMask tab shows a Demo button)
# false = real Sepolia (MetaMask tab pays for real; M2M tabs need a funded payer key in wallet.json)
MOCK_VERIFY=true

# Prices (testnet, reporting only). Per-reading value is equal in both M2M tabs → fair comparison.
SERVICE_PRICE_ETH=0.0000001
PRICE_WEI_PER_READING=100000000000
PRICE_WEI_PER_CALL=100000000000
PRICE_WEI_PER_BYTE=0
MIN_PRICE_WEI=100000000000
ETH_EUR_RATE=2500

# Metered session
DEBIT_MAX_AGE_MS=120000
SESSION_TTL_DEFAULT=3600
SESSION_TTL_MAX=86400
# Real-mode top-up value (wei) sent by the M2M agent to open a session
TOPUP_WEI=2500000000000

# TTLs
PROOF_TOKEN_TTL_SECONDS=600
PAYMENT_REQUEST_TTL_SECONDS=1800

# ── Skrbniška prijava (glej ../../README.md) ─────────────────────────────────
# Celotno spletišče je zaprto; javna ostaneta samo /health in /prijava.
# Poverilnice se ob prvem zagonu ustvarijo same v data/admin-credentials.txt (0600):
#   grep GESLO data/admin-credentials.txt      # za prijavo v brskalniku
#   grep ZETON data/admin-credentials.txt      # strojni žeton (Bearer)
# Spodnje nastavi SAMO, če hoceš poverilnice določiti sam (takrat se nič ne zapiše na disk):
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# ADMIN_TOKEN=
ADMIN_SESSION_TTL_SECONDS=28800

# ── Sejni žeton `sid` (docs/IDENTITETA.md §2, izboljšava B) ──────────────────────
# Piškotek za KORELACIJO dogodkov iste seje (402 -> dokazilo -> dostop).
# NIKOLI ni pogoj za dostop: manjkajoč/spremenjen sid ali menjava IP ne zavrne
# zahteve, zato potek preživi menjavo omrežja (wifi <-> mobilni internet, NAT).
WEB_SESSION_TTL_SECONDS=1800
# Pusti na false. Zastavica `Secure` se doda SAMODEJNO, ko zahteva pride po HTTPS
# (tudi izza Caddyja prek X-Forwarded-Proto). Če to vsiliš na true, prijava v
# brskalniku po navadnem HTTP (dostop za Wireshark) ne bo delovala — brskalnik
# takega piškotka ne shrani.
COOKIE_SECURE=false

# ── x402 v2 (VZPOREDNI način — uradni protokol; TESTNO: ETH, Ethereum Sepolia) ─
# Obstoječe spremenljivke zgoraj veljajo za domači ETH tok in se NE spreminjajo.
# X402_MODE=off      → /x402/* poti se ne priklopijo (privzeto)
# X402_MODE=self     → strežnik sam preverja in poravnava prek X402_RPC_URL
# X402_MOCK=true     → prava preverjanja podpisov, sintetične poravnave (0x6d6f636b…)
# POZOR: pravi (ne-mock) zagon s testnim (placeholder) sredstvom strežnik ob
# zagonu zavrne — poravnava je v tej konfiguraciji vedno sintetična/mock.
#X402_MODE=self
#X402_MOCK=true
#X402_MOCK_FAULTS=false
#X402_NETWORK=eip155:11155111
#X402_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#X402_MERCHANT_ADDRESS=
#X402_SETTLEMENT_PRIVATE_KEY=
#X402_PRICE_ATOMIC=100000000000
# ↑ 0,0000001 ETH v wei — enaka cena kot v domačem ETH toku
#X402_MIN_CONFIRMATIONS=1
#X402_SETTLE_TIMEOUT_MS=60000
#X402_SESSION_DEPOSIT_ATOMIC=2000000000000
# ↑ 0,000002 ETH v wei — polog merjene seje
