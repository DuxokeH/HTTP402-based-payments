# ── X402 POSREDNIK (facilitator) — kopiraj v .env ────────────────────────────
# To je EDINI proces v mapi 04_spletisce_posrednik, ki se pogovarja z verigo.
# Trgovec (../streznik) `JsonRpcProvider` sploh nima — to je bistvo topologije (b).
NODE_ENV=development
POSREDNIK_PORT=4000
LOG_LEVEL=info

NETWORK=sepolia
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Uveljavljeno je, ne le dokumentirano (popravek napake 4 stare izvedbe).
MIN_CONFIRMATIONS=1

# true = brez verige (demo/mock meritve). Isto vrednost nastavi tudi trgovcu,
# sicer bo trgovec pošiljal prave transakcije posredniku, ki jih ne preverja.
# `MOCK_FACILITATOR=true` deluje kot vzdevek za isto stvar.
MOCK_VERIFY=true

# Koliko hkratnih branj verige posrednik dovoli; presežek dobi takoj 429 in se
# NE kopiči v čakalni vrsti. Omejitev ni vezana na IP (glej ../../docs/IDENTITETA.md).
MAX_CHAIN_READS_IN_FLIGHT=8

# Življenjske dobe (enake kot v neposredni veji — primerjava mora biti poštena)
PROOF_TOKEN_TTL_SECONDS=600
PAYMENT_REQUEST_TTL_SECONDS=1800

# Merjena seja: posrednik hrani dobroimetje, proračun in veljavnost
DEBIT_MAX_AGE_MS=120000
SESSION_TTL_DEFAULT=3600
SESSION_TTL_MAX=86400

# ── Skrbniška prijava (glej ../../README.md) ────────────────────────────────
# Posrednik avtenticira TRGOVCE, ne plačnikov.
#   javno:         /health, /config, /submit-payment
#   strojni žeton: /payment-request, /verify-proof, /session/*, /debit
# Žeton preberi z:  grep ZETON data/admin-credentials.txt
# in ga trgovcu podaj kot POSREDNIK_TOKEN v ../streznik/.env
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# ADMIN_TOKEN=
ADMIN_SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false

# ── x402 v2 (VZPOREDNI način — uradni protokol; testno: ETH, Ethereum Sepolia) ──
# Obstoječe spremenljivke zgoraj veljajo za domači ETH tok in se NE spreminjajo.
# X402_MODE=off      → /x402/* poti se ne priklopijo (privzeto)
# X402_MODE=self     → strežnik sam preverja in poravnava prek X402_RPC_URL
# X402_MOCK=true     → prava preverjanja podpisov, sintetične poravnave (0x6d6f636b…)
#X402_MODE=self
#X402_MOCK=true
#X402_MOCK_FAULTS=false
# Poravnava je v tej konfiguraciji vedno sintetična/mock (domači ETH nima
# EIP-3009 pogodbe); pravi (ne-mock) tek zahteva EIP-3009 žeton (npr. USDC/EURC).
#X402_NETWORK=eip155:11155111
#X402_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#X402_MERCHANT_ADDRESS=
#X402_SETTLEMENT_PRIVATE_KEY=
#X402_PRICE_ATOMIC=100000000000   # 0.0000001 ETH — kot domači tok
#X402_MIN_CONFIRMATIONS=1
#X402_SETTLE_TIMEOUT_MS=60000
